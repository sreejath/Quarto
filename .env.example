# Copy this file to .env (strictly git-ignored — NEVER commit .env to GitHub).
# Loaded automatically by both the CLI and Browser UI (jira2ado-ui).

JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your_atlassian_api_token

ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PAT=your_azure_devops_pat

# Optional: Zephyr Squad Cloud API Keys (Jira -> Apps -> Zephyr Squad -> API Keys)
ZEPHYR_ACCESS_KEY=your_zephyr_access_key
ZEPHYR_SECRET_KEY=your_zephyr_secret_key
# ZEPHYR_BASE_URL=https://prod-api.zephyr4jiracloud.com/connect
